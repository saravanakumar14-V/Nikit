{
  "name": "nikit-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @nikit/desktop dev",
    "tauri": "pnpm --filter @nikit/desktop tauri",
    "tauri:dev": "pnpm --filter @nikit/desktop tauri dev",
    "tauri:build": "pnpm --filter @nikit/desktop tauri build",
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "pnpm --recursive run lint",
    "test": "pnpm --filter @nikit/desktop test"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@11.14.0"
}
